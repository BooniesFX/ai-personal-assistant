# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ============================================
# ADMIN & PERMISSIONS
# ============================================
ADMIN_ID=your_telegram_user_id

# ============================================
# IMAGE GENERATION MODULE (Multi-Provider)
# ============================================
IMAGE_API_KEY=your-image-api-key
IMAGE_PROVIDER=modelscope
IMAGE_BASE_URL=https://api-inference.modelscope.cn/
IMAGE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo  # Model ID specific to provider

# Image Generation Defaults (Optional)
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
DEFAULT_STEPS=30

# ============================================
# OPS MODULE (Daily Practice System)
# ============================================
# LLM API for OPS (OpenAI-compatible)
OPS_LLM_API_KEY=your_llm_api_key
OPS_LLM_BASE_URL=https://api.openai.com/v1
OPS_LLM_MODEL=gpt-4o-mini
OPS_REMINDER_TIME=20:00

# ============================================
# CLAUDE AGENT MODULE (Multi-LLM Support)
# ============================================
# Required for Claude Agent mode
LLM_PROVIDER=cas  # Options: anthropic, cas, openai

# OpenAI-compatible endpoint config (when LLM_PROVIDER=openai or cas)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key

# CAS (Claude Agent Server) config (when LLM_PROVIDER=cas)
LLM_API_COMPATIBILITY=openai  # Options: anthropic, openai

# Claude Agent Model Configuration
LLM_MODEL=claude-3-5-sonnet-20241022  # Default model for Claude Agent
LLM_MAX_TOKENS=4096  # Default max tokens for Claude Agent

# ============================================
# UNIFIED IDENTITY SYSTEM
# ============================================
# Access password for Web login and Telegram binding
WEB_ACCESS_PASSWORD=123456

# ============================================
# MCP SERVERS
# ============================================
# Tavily Search MCP (SSE)
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/?tavilyApiKey=your_tavily_api_key
