# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ModelScope API Configuration
MODELSCOPE_API_KEY=your_modelscope_api_key
# Optional: Custom Base URL (default: https://api-inference.modelscope.cn/)
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/
# Optional: Custom Model ID (default: Tongyi-MAI/Z-Image-Turbo)
MODELSCOPE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo

# Admin Configuration
ADMIN_ID=your_telegram_user_id

# Image Generation Defaults (Optional)
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
DEFAULT_STEPS=30
