# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ============================================
# ADMIN & PERMISSIONS
# ============================================
ADMIN_ID=your_telegram_user_id

# ============================================
# IMAGE GENERATION MODULE (ModelScope)
# ============================================
MODELSCOPE_API_KEY=your_modelscope_api_key
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/
MODELSCOPE_MODEL_ID=Tongyi-MAI/Z-Image-Turbo

# Image Generation Defaults (Optional)
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
DEFAULT_STEPS=30

# ============================================
# OPS MODULE (Daily Practice System)
# ============================================
# LLM API for OPS (OpenAI-compatible)
OPS_LLM_API_KEY=your_llm_api_key
OPS_LLM_BASE_URL=https://api.openai.com/v1
OPS_LLM_MODEL=gpt-4o-mini
OPS_REMINDER_TIME=20:00
