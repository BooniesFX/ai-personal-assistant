# Z-Image Turbo 模型客户端配置文件


# Telegram Bot Configuration
[telegram]
# Bot Token (from @BotFather)
# 建议通过环境变量设置: export TELEGRAM_BOT_TOKEN="your_token"
bot_token = 

# ModelScope API配置
[modelscope]
# API基础URL
base_url = 

# 模型ID
model_id = Tongyi-MAI/Z-Image-Turbo

# API密钥 (请勿在此处硬编码真实的API密钥)
# 建议通过环境变量设置: export MODELSCOPE_API_KEY="your_api_key"
api_key = 

# 权限配置
[auth]
# 管理员ID (从 @userinfobot 获取)
# 建议通过环境变量设置: export ADMIN_ID="your_id"
admin_id = 

# 默认参数
[defaults]

# 超时设置 (秒)
timeout = 300

# 图像处理设置
[image_processing]
# 默认生成参数
default_width = 1024
default_height = 1024
default_steps = 15
